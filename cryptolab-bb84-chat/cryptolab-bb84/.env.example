# Optional IBM watsonx.ai integration for the Bob Copilot panel.
# The app runs without these values and uses a local educational fallback.

IBM_CLOUD_API_KEY=replace_with_your_ibm_cloud_api_key
WATSONX_API_KEY=replace_with_your_watsonx_or_ibm_cloud_api_key
WATSONX_PROJECT_ID=replace_with_your_watsonx_project_id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Optional FastAPI chat endpoint
CHAT_API_KEY=dev-chat-key
CHAT_SIMULATION_MODE=true
SIMULATED_LATENCY_MS=250
